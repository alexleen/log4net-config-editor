<Window x:Class="Editor.Windows.RefsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Editor.Windows"
        xmlns:Converters="clr-namespace:Editor.Converters"
        mc:Ignorable="d"
        Height="432" 
        Width="768"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Converters:RefSelectionConverter x:Key="RefSelectionConverter"/>
    </Window.Resources>
    <DockPanel>
        <Label DockPanel.Dock="Top">The following is a list of locations where this appender is referenced. References can be added or removed.</Label>
        <StackPanel DockPanel.Dock="Right" Width="150">
            <ComboBox x:Name="xRefComboBox" Margin="5" SelectedIndex="0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Label Padding="0" Content="{Binding Converter={StaticResource RefSelectionConverter}}"></Label>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Margin="5" Click="AddRefOnClick">Add Ref</Button>
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Width="50" Margin="5" Click="CloseOnClick">Close</Button>
        <DataGrid x:Name="xRefsGrid" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Element" Binding="{Binding ElementName}"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Type" Binding="{Binding AppenderType}"/>
                <DataGridTemplateColumn Header="Options">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Width="50" Margin="5" Click="RemoveRefOnClick">Remove</Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

