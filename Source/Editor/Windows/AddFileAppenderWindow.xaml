<Window x:Class="Editor.Windows.AddFileAppenderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Editor.Windows"
        mc:Ignorable="d"
        Title="File Appender" 
        Height="350" 
        Width="500"        
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Label FontWeight="Bold">Name:</Label>
        <TextBox x:Name="xNameTextBox" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="300" Height="21" />

        <Label Grid.Row="1" Grid.Column="0" FontWeight="Bold">File:</Label>
        <StackPanel Grid.Row="1" Grid.Column="1">
            <StackPanel  Orientation="Horizontal">
                <TextBox x:Name="xFileTextBox" VerticalAlignment="Center" Width="300" Height="21" />
                <Button Width="50" Margin="5">Open</Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <RadioButton IsChecked="True">Append</RadioButton>
                <RadioButton x:Name="xOverwriteRb" Margin="5,0">Overwrite</RadioButton>
            </StackPanel>
        </StackPanel>

        <Label Grid.Row="2" Grid.Column="0" FontWeight="Bold">Layout:</Label>
        <StackPanel Grid.Row="2" Grid.Column="1">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="xLayoutComboBox" Width="75" Height="21" Margin="0,5" SelectedIndex="0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Label Padding="0" Content="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Label VerticalAlignment="Center">Pattern:</Label>
                <TextBox x:Name="xPatternTextBox" Width="300" Height="21"/>
            </StackPanel>
            <TextBlock>  
                For more information regarding patterns, see
                <Hyperlink NavigateUri="https://logging.apache.org/log4net/release/sdk/html/T_log4net_Layout_PatternLayout.htm" RequestNavigate="HyperlinkOnRequestNavigate">
                    Pattern Layout
                </Hyperlink>.
            </TextBlock>
        </StackPanel>
        <Label Grid.Row="3" Grid.Column="0" FontWeight="Bold">Filters:</Label>
        <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,5,0,0">
            <StackPanel DockPanel.Dock="Right">
                <ComboBox Width="100" Margin="5,0,5,5" SelectedIndex="0">
                    <ComboBoxItem>Deny All</ComboBoxItem>
                    <ComboBoxItem>Level Match</ComboBoxItem>
                    <ComboBoxItem>Level Range</ComboBoxItem>
                    <ComboBoxItem>Level Range</ComboBoxItem>
                    <ComboBoxItem>MDC</ComboBoxItem>
                    <ComboBoxItem>NDC</ComboBoxItem>
                    <ComboBoxItem>Property</ComboBoxItem>
                    <ComboBoxItem>String Match</ComboBoxItem>
                </ComboBox>
                <Button Width="100" Margin="5,0,5,5">Add</Button>
                <Button Width="100" Margin="5,0,5,5">Remove</Button>
                <Button Width="100" Margin="5,0,5,5">Move Up</Button>
                <Button Width="100" Margin="5,0,5,0">Move Down</Button>
            </StackPanel>
            <DataGrid>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Type" />
                    <DataGridTextColumn Header="Value" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Width="50" Margin="5" Click="SaveOnClick">Save</Button>
            <Button Width="50" Margin="5" Click="CloseOnClick">Close</Button>
        </StackPanel>
        
    </Grid>
</Window>

